{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "WEEKLY_MENU_DATABASE_URL",
    "KITH_INN_DATABASE_URL",
    "KITH_INN_WECHAT_APP_ID",
    "KITH_INN_WECHAT_APP_SECRET",
    "KITH_INN_WECHAT_OWNER_OPEN_ID",
    "PORT",
    "PAYLOAD_DATABASE_URL",
    "PAYLOAD_SECRET",
    "PAYLOAD_DB_PUSH",
    "ALLOW_ADMIN_BOOTSTRAP",
    "NEXT_PUBLIC_SITE_URL",
    "DATABASE_URI",
    "DATABASE_URL_UNPOOLED",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_URL",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_BASE_URL",
    "DEEPSEEK_MODEL",
    "CHAT_RATE_LIMIT_PER_MINUTE",
    "CHAT_RATE_LIMIT_PER_HOUR",
    "SUMMARY_RATE_LIMIT_PER_MINUTE",
    "SUMMARY_RATE_LIMIT_PER_HOUR",
    "RELEASE_SHA",
    "VERCEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "@cfp/kith-inn-miniapp#build": {
      "dependsOn": ["^build"],
      "env": ["TARO_APP_ID", "TARO_APP_KITH_INN_API_BASE_URL"],
      "outputs": ["dist/**"]
    },
    "@cfp/kith-inn-api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@cfp/kith-inn-api#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@cfp/kith-inn-api#test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "@cfp/ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
