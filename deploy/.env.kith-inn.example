# Copy outside the repository, chmod 600, fill securely. Never print resolved compose config.
# KITH_INN_IMAGE / KITH_INN_ENV_FILE belong in the operator shell, not this API env file.
# Runtime role has DML only; migration uses a separate private env file and owner role.
KITH_INN_DATABASE_URL=postgresql://kith_inn_runtime:replace-locally@private-db:5432/kith_inn
KITH_INN_WECHAT_APP_ID=replace-with-existing-miniapp-id
KITH_INN_WECHAT_APP_SECRET=replace-only-on-server
KITH_INN_WECHAT_OWNER_OPEN_ID=replace-with-verified-owner
