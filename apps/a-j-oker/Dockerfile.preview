FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
RUN apk add --no-cache font-wqy-zenhei
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.2.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches patches
COPY apps/a-j-oker/package.json apps/a-j-oker/package.json
COPY packages/a-j-oker-contracts/package.json packages/a-j-oker-contracts/package.json
COPY packages/a-j-oker-protocol/package.json packages/a-j-oker-protocol/package.json
COPY packages/eslint-config packages/eslint-config
COPY packages/typescript-config packages/typescript-config
RUN pnpm install --frozen-lockfile --filter @cfp/a-j-oker... --ignore-scripts
COPY apps/a-j-oker apps/a-j-oker
COPY packages/a-j-oker-contracts packages/a-j-oker-contracts
COPY packages/a-j-oker-protocol packages/a-j-oker-protocol
# H5 在开发机编译，并随经过白名单筛选的源码包传入；不在 ECS 重装 Taro。
RUN test -f apps/a-j-oker/public/chat/index.html
# 将类型检查与打包分开，避免小型 ECS 同时驻留编译器和类型检查子进程。
RUN NODE_OPTIONS=--max-old-space-size=1024 pnpm --filter @cfp/a-j-oker typecheck
RUN HELLO_BUILD_PREVIEW=true HELLO_BUILD_TYPES_VERIFIED=true NODE_OPTIONS=--max-old-space-size=1024 RAYON_NUM_THREADS=1 pnpm --filter @cfp/a-j-oker exec next build --webpack
RUN mkdir -p apps/a-j-oker/.data && chown -R node:node apps/a-j-oker/.data apps/a-j-oker/.next
ENV NODE_ENV=production
USER node
WORKDIR /app/apps/a-j-oker
EXPOSE 3310
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3310"]
