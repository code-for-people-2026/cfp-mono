{
  "name": "@cfp/a-j-oker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-miniapp.mjs && next dev -H 127.0.0.1 -p 3310",
    "build": "node scripts/sync-miniapp.mjs && next build",
    "start": "node scripts/sync-miniapp.mjs && tsx scripts/init-db.ts && next start -H 127.0.0.1 -p 3310",
    "db:init": "tsx scripts/init-db.ts",
    "db:memory": "node scripts/migrate-memory.mjs",
    "db:migration": "tsx scripts/create-migration.ts",
    "typecheck": "tsx scripts/generate-types.ts --check && tsc --noEmit",
    "generate:types": "tsx scripts/generate-types.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && pnpm test:integration",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:http": "tsx scripts/http-smoke.ts",
    "test:integration": "node scripts/image-context-check.mjs && node scripts/preview-data-check.mjs && tsx scripts/integration.ts && tsx scripts/preview-recovery-check.ts && tsx scripts/external-retry-check.ts && tsx scripts/image-storage-check.ts && tsx scripts/oss-storage-check.ts && tsx scripts/image-schema-check.ts && tsx scripts/artifact-check.ts && tsx scripts/platform-quota-check.ts && tsx scripts/privacy-check.ts && tsx scripts/privacy-migration-check.ts && pnpm test:profile && pnpm test:configuration && pnpm test:moderation && pnpm test:operations && pnpm test:images",
    "db:images": "tsx scripts/migrate-images.ts",
    "test:external": "tsx scripts/external-smoke.ts",
    "eval": "tsx scripts/evaluate.ts",
    "eval:safety:prepare": "tsx scripts/prepare-safety-bank.ts",
    "eval:safety:live": "tsx scripts/run-safety-regression.ts",
    "eval:safety:lexicon": "tsx scripts/check-project-lexicon.ts",
    "eval:safety:reconcile": "tsx scripts/reconcile-safety-budget.ts",
    "eval:promptfoo": "pnpm dlx promptfoo@0.123.1 eval --config promptfooconfig.yaml --no-cache --max-concurrency 1",
    "external-agent": "tsx scripts/external-agent.ts",
    "cms:admin": "tsx scripts/create-admin.ts",
    "eval:psychology": "tsx scripts/evaluate-psychology-agents.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:rename-brand": "tsx scripts/rename-brand.ts",
    "test:configuration": "tsx scripts/agent-configuration-check.ts",
    "eval:knowledge": "tsx scripts/evaluate-knowledge.ts",
    "test:privacy-operations": "python3 scripts/privacy-operations-check.py && node scripts/privacy-snapshot-check.mjs && tsx scripts/privacy-restore-check.ts",
    "test:forget-context": "tsx scripts/forget-context-check.ts",
    "test:moderation": "tsx scripts/moderation-check.ts && tsx scripts/moderation-lifecycle-check.ts && tsx scripts/moderation-failure-check.ts && tsx scripts/moderation-content-check.ts && tsx scripts/public-admission-check.ts && tsx scripts/public-admission-check.ts --rollback-journal",
    "test:moderation:live": "node --env-file=.env.local --import tsx scripts/moderation-live-check.ts",
    "test:artifacts": "tsx scripts/artifact-check.ts",
    "test:images": "tsx scripts/image-generation-check.ts && tsx scripts/image-generation-migration-check.ts && tsx scripts/image-quota-check.ts && tsx scripts/image-review-quota-check.ts",
    "test:operations": "tsx scripts/operations-check.ts && tsx scripts/operations-migration-check.ts",
    "operations:maintenance": "tsx scripts/operations-maintenance.ts",
    "operations:preview": "tsx scripts/operations-preview.ts",
    "test:age": "tsx scripts/age-verification-check.ts && tsx scripts/age-migration-check.ts",
    "age:preview": "node scripts/age-preview.mjs",
    "test:feishu": "tsx scripts/sqlite-contention-check.ts && tsx scripts/sqlite-concurrent-operations-check.ts && tsx scripts/transaction-failure-check.ts && tsx scripts/feishu-alerts-check.ts",
    "test:sqlite-connections": "node scripts/sqlite-connection-check.mjs",
    "alerts:feishu": "tsx scripts/feishu-alerts.ts",
    "test:images:live": "tsx scripts/image-generation-live.ts",
    "test:profile": "tsx scripts/profile-check.ts",
    "test:interaction": "tsx scripts/interaction-check.ts && tsx scripts/product-guidance-check.ts"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@alicloud/green20220302": "3.6.8",
    "@alicloud/openapi-core": "1.0.8",
    "@cfp/a-j-oker-contracts": "workspace:*",
    "@cfp/base-chat-protocol": "workspace:*",
    "@darabonba/typescript": "1.0.5",
    "@google/adk": "2.1.0",
    "@google/genai": "^2.9.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@payloadcms/db-sqlite": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "ali-oss": "6.23.0",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "libsql": "0.5.29",
    "next": "16.2.9",
    "payload": "3.85.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.34.5",
    "unique-names-generator": "4.7.1",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@balena/dockerignore": "1.0.2",
    "@types/ali-oss": "6.23.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20.19.26",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  }
}
