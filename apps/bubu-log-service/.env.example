# These variables are read from the process environment; this file is not loaded automatically.
HOST=127.0.0.1
PORT=3320
# H5: browser-visible origin, including its development port. Native-only local service: 3320.
BUBU_PUBLIC_ORIGIN=http://127.0.0.1:10086
# Native Payload Admin is served by this same process. Production requires exact HTTPS origin.
BUBU_OPS_ORIGIN=http://127.0.0.1:3320
BUBU_IDENTITY_DIRECTORY=/absolute/private/path/bubu-identity
# Same directory owns care metadata and private-attachments; include both in consistent backups.
# Required with NODE_ENV=production; use a randomly generated private secret, not this example.
BUBU_PAYLOAD_SECRET=
BUBU_WECHAT_APP_ID=
BUBU_WECHAT_APP_SECRET=
# Existing bubu-log site. No requests are made until a user operation needs it.
BUBU_LEGACY_ORIGIN=http://127.0.0.1:1030
# A dedicated legacy CMS administrator, stored only on this server.
BUBU_LEGACY_CMS_EMAIL=
BUBU_LEGACY_CMS_PASSWORD=
# Exact HTTPS origins of historical photo storage, comma separated. Empty fails closed.
BUBU_LEGACY_MEDIA_ORIGINS=
# Server-only vision + function-calling Chat Completions provider. Never ship keys to the miniapp.
# Empty key/model keeps login/calendar available and reports CHAT_PROVIDER_NOT_CONFIGURED on send.
BUBU_CHAT_BASE_URL=https://api.openai.com/v1
BUBU_CHAT_API_KEY=
BUBU_CHAT_MODEL=
# Chat and operations MCP always use http://127.0.0.1:<PORT>/api/mcp in this process.
# The delegate credential is sent only by the server's MCP transport.
# First administrator only: stop the service, inject private values, run cms:admin, then unset.
# The administrator also needs explicit baby IDs. Empty scopes allow account administration only.
BUBU_OPS_ADMIN_EMAIL=
BUBU_OPS_ADMIN_PASSWORD=
BUBU_OPS_ADMIN_BABY_IDS=
# Read-only mount of the entire host status directory; see docs/backup-operations.md.
# Missing/unreadable report is shown as unconfigured/failed, never healthy.
BUBU_OPERATIONS_REPORT=
# Collector is a separate explicit CLI; its private JSON config and token file are not loaded here.
# See docs/collector.md. Service start never enables or schedules collection.
