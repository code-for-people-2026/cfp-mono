# Values must be confirmed for Bubu; blank values prevent consent and data processing.
BUBU_PRIVACY_COMPANY=
BUBU_PRIVACY_CONTACT=
BUBU_PRIVACY_STORAGE_LOCATION=
BUBU_PRIVACY_LEGACY_STORAGE_LOCATION=
BUBU_PRIVACY_CHAT_DAYS=
BUBU_PRIVACY_BACKUP_DAYS=
BUBU_PRIVACY_ORPHAN_HOURS=
BUBU_PRIVACY_RESPONSE_DAYS=
BUBU_PRIVACY_MODEL_NAME=
BUBU_PRIVACY_MODEL_REGION=
BUBU_PRIVACY_MODEL_POLICY=
# 64 hex characters, generate and store in a private environment file; never in data snapshots.
BUBU_MEDIA_ENCRYPTION_KEY=
# Absolute, outside BUBU_IDENTITY_DIRECTORY. Pre-provision the empty file only on first setup.
BUBU_DELETION_LEDGER=

# Required separately to enable new image processing; mode/credentials are in .env.example.
# Fill only after reviewing the actual supplier terms, region, retention and deletion process.
# Any change alters the consent policy version. Do not use placeholder promises in production.
BUBU_PRIVACY_IMAGE_REVIEW_POLICY=
BUBU_PRIVACY_IMAGE_REVIEW_HANDLING=
