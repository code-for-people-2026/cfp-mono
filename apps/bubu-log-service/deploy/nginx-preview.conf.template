# Replace hostname and retain the operator IP allowlist before nginx -t/reload.
map $request_method $bubu_preview_write_key {
  default "";
  POST $binary_remote_addr;
  PATCH $binary_remote_addr;
  DELETE $binary_remote_addr;
}
limit_req_zone $bubu_preview_write_key zone=bubu_preview_writes:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=bubu_preview_connections:10m;
server {
  listen 80;
  server_name __HOSTNAME__;
  return 308 https://__HOSTNAME__$request_uri;
}
server {
  listen 443 ssl http2;
  server_name __HOSTNAME__;
  ssl_certificate /opt/cfp-bubu-log/private/fullchain.pem;
  ssl_certificate_key /opt/cfp-bubu-log/private/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  __ADMIN_ALLOW_RULES__
  allow 127.0.0.1;
  deny all;
  client_max_body_size 10m;
  access_log /var/log/nginx/bubu-preview.access.log;
  error_log /var/log/nginx/bubu-preview.error.log;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  add_header X-Content-Type-Options nosniff always;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto https;
  proxy_read_timeout 180s;
  limit_req_status 429;
  limit_conn_status 429;
  location = /health {
    allow all;
    proxy_pass http://127.0.0.1:3320;
  }
  location ^~ /api/identity/ {
    allow all;
    limit_req zone=bubu_preview_writes burst=20 nodelay;
    limit_conn bubu_preview_connections 5;
    proxy_pass http://127.0.0.1:3320;
  }
  location ^~ /api/app/ {
    allow all;
    limit_req zone=bubu_preview_writes burst=20 nodelay;
    limit_conn bubu_preview_connections 5;
    proxy_buffering off;
    proxy_pass http://127.0.0.1:3320;
  }
  # MCP, Payload and operations remain available only to operator networks.
  # In-app chat calls MCP through the loopback transport inside this process.
  location / {
    proxy_pass http://127.0.0.1:3320;
  }
}
