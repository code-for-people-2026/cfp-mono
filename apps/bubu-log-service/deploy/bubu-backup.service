[Unit]
Description=Bubu encrypted stopped-writer backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/cfp-bubu-log/private/operations.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/cfp-bubu-log/operations/scripts/backup-operations.py backup --config /opt/cfp-bubu-log/private/operations.json --apply
TimeoutStartSec=20min
TimeoutStopSec=180
# Let Python's SIGTERM handler restore the original service before killing remaining children.
KillMode=mixed
NoNewPrivileges=true
