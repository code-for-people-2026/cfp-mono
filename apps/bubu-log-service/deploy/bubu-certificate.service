[Unit]
Description=Verify Bubu public HTTPS certificate
After=network-online.target
ConditionPathExists=/opt/cfp-bubu-log/private/operations.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/cfp-bubu-log/operations/scripts/backup-operations.py certificate --config /opt/cfp-bubu-log/private/operations.json
TimeoutStartSec=60
NoNewPrivileges=true
