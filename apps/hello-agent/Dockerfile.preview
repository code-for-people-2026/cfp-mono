FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS base
RUN apk add --no-cache font-wqy-zenhei

FROM base AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.2.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches patches
COPY apps/hello-agent/package.json apps/hello-agent/package.json
COPY packages/hello-agent-contracts/package.json packages/hello-agent-contracts/package.json
COPY packages/hello-agent-protocol/package.json packages/hello-agent-protocol/package.json
COPY packages/eslint-config packages/eslint-config
COPY packages/typescript-config packages/typescript-config
RUN pnpm install --frozen-lockfile --filter @cfp/hello-agent... --ignore-scripts
COPY apps/hello-agent apps/hello-agent
COPY packages/hello-agent-contracts packages/hello-agent-contracts
COPY packages/hello-agent-protocol packages/hello-agent-protocol
# H5 在开发机编译，并随经过白名单筛选的源码包传入；不在 ECS 重装 Taro。
RUN test -f apps/hello-agent/public/chat/index.html
# 将类型检查与打包分开，避免小型 ECS 同时驻留编译器和类型检查子进程。
RUN NODE_OPTIONS=--max-old-space-size=1024 pnpm --filter @cfp/hello-agent typecheck
RUN HELLO_BUILD_PREVIEW=true HELLO_BUILD_TYPES_VERIFIED=true NODE_OPTIONS=--max-old-space-size=1024 RAYON_NUM_THREADS=1 pnpm --filter @cfp/hello-agent exec next build --webpack
# Never ship compilation caches or build-time local database/secret files.
RUN rm -rf apps/hello-agent/.next/cache apps/hello-agent/.data \
    && mkdir -p apps/hello-agent/.data

FROM base AS runtime
WORKDIR /app
# Preserve the dependency graph used by the separate tsx alert worker. The pnpm
# download store, build layers and compilation caches stay in the build stage.
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build --chown=node:node /app/apps/hello-agent ./apps/hello-agent
ENV NODE_ENV=production
USER node
WORKDIR /app/apps/hello-agent
EXPOSE 3310
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3310"]
