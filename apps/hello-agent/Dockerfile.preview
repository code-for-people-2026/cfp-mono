FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.2.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/hello-agent/package.json apps/hello-agent/package.json
RUN pnpm install --frozen-lockfile --filter @cfp/hello-agent --ignore-scripts
COPY apps/hello-agent apps/hello-agent
# H5 在开发机编译，并随经过白名单筛选的源码包传入；不在 ECS 重装 Taro。
RUN test -f apps/hello-agent/public/chat/index.html
RUN HELLO_BUILD_PREVIEW=true NODE_OPTIONS=--max-old-space-size=1536 pnpm --filter @cfp/hello-agent exec next build
RUN mkdir -p apps/hello-agent/.data && chown -R node:node apps/hello-agent/.data apps/hello-agent/.next
ENV NODE_ENV=production
USER node
WORKDIR /app/apps/hello-agent
EXPOSE 3310
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3310"]
