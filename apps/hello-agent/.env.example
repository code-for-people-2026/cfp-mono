# 仅本项目使用，不连接其他应用的数据库。
HELLO_DATABASE_URI=file:./.data/hello.db
# 独立远程新库启用正式迁移；不要对已有本机开发库直接开启。
HELLO_DEPLOYED=false
# 仅在应用端口不可公网直连、代理覆盖 X-Real-IP 时启用；部署恢复码入口必需。
HELLO_TRUST_PROXY=false
# 本地留空则自动生成并保存在 .data/secret；部署时显式填入足够长的随机密钥。
PAYLOAD_SECRET=
HELLO_ORIGIN=http://127.0.0.1:3310
# 平台模式；BYOK 使用页面提交的当次密钥，不写入数据库。
DEEPSEEK_API_KEY=
# 所有访客共享的 UTC 每日模型调用预算。生成预扣最多 9 次，记忆整理预扣 1 次；
# 不按实际调用退款，失败/重启不恢复额度。0 暂停平台生成，BYOK/外部 Agent 不受影响。
HELLO_PLATFORM_DAILY_CALL_LIMIT=900
HELLO_MODEL=deepseek-flash
# 本机预览可设为 true 开放首个管理员注册；已有管理员后仍禁止匿名创建。
HELLO_ADMIN_BOOTSTRAP=false
# 本地默认 demo，明确显示演示广告；disabled 关闭。wechat 只允许本机广告位联调。
# 非本地 HELLO_ORIGIN 一律禁用：正式奖励仍需接入可信广告服务端验证，不能信任客户端声明。
HELLO_AD_MODE=demo
# 仅在测试部署显式设置 preview：免费整理记忆，不生成广告观看资格；默认关闭。
HELLO_MEMORY_RECOVERY=disabled
WECHAT_REWARDED_AD_UNIT_ID=
# 图片存储：本地演示默认 database，线上改为 oss。不要把密钥交给客户端。
HELLO_MEDIA_STORAGE=database
HELLO_OSS_BUCKET=
HELLO_OSS_REGION=oss-cn-shenzhen
HELLO_OSS_INTERNAL=false
HELLO_OSS_ACCESS_KEY_ID=
HELLO_OSS_ACCESS_KEY_SECRET=

# 隐私运营资料：必须填真实值并落实作业后才可批准，详见 docs/privacy-labeling-acceptance.md。
# 未配置时部署模式拒绝新的数据处理，/api/ready 返回 503；权利入口仍可用。
# HELLO_PRIVACY_CONTACT=
# HELLO_PRIVACY_RESPONSE_DAYS=
# HELLO_PRIVACY_STORAGE_LOCATION=
# HELLO_PRIVACY_RETENTION_DAYS=
# HELLO_PRIVACY_BACKUP_DAYS=
# HELLO_PRIVACY_DELETION_LEDGER=  # 独立于数据库快照的受限持久文件绝对路径
# HELLO_PRIVACY_OPERATIONS_APPROVED=false
# 配置图片审核代理时还必须提供接收方真实告知。
# HELLO_IMAGE_REVIEW_PROVIDER=
# HELLO_IMAGE_REVIEW_CONTACT=
# HELLO_IMAGE_REVIEW_REGION=
# HELLO_IMAGE_REVIEW_PRIVACY_URL=
# 上传图片通过阿里云上海内容安全增强版审核后交给 DeepSeek 识图。
# 审核凭证仅供服务端使用；未配置时不接收图片。
HELLO_IMAGE_REVIEW_MODE=aliyun-green
HELLO_GREEN_ACCESS_KEY_ID=
HELLO_GREEN_ACCESS_KEY_SECRET=
# 图片审核按 UTC 日持久预留，覆盖上传、补审和继续取图时的再次审核。
# 失败或未知结果不退款；0 暂停新的审核请求，已审核保存图片仍可读取。
HELLO_IMAGE_REVIEW_OWNER_DAILY_LIMIT=100
HELLO_IMAGE_REVIEW_GLOBAL_DAILY_LIMIT=1000

# 微信登录：通过私密服务端配置提供 AppSecret，不能放进小程序代码。
HELLO_WECHAT_APP_ID=
HELLO_WECHAT_APP_SECRET=
# aliyun：阿里云身份二要素；tencent：腾讯云未成年人识别。
# 仅配置对应供应商的服务端凭证，不写入小程序。
HELLO_AGE_PROVIDER=aliyun
HELLO_AGE_SECRET_ID=
HELLO_AGE_SECRET_KEY=
HELLO_AGE_PROVIDER_APPROVED=false
HELLO_AGE_PROVIDER_DISCLOSURE=

# 专用文生图：北京地域百炼 API Key，与 OSS 密钥分开；留空时禁用。
DASHSCOPE_API_KEY=
HELLO_IMAGE_WORKSPACE_ID=
# BYOK/平台模式共用的 UTC 每日新生图任务预算；已有任务恢复不重复预留。
HELLO_IMAGE_OWNER_DAILY_LIMIT=10
HELLO_IMAGE_GLOBAL_DAILY_LIMIT=100
# 若显式使用受信任的 HTTPS 审核代理，将 MODE 改为 proxy，并填写供应商告知。
HELLO_IMAGE_REVIEW_URL=
HELLO_IMAGE_REVIEW_TOKEN=
