# sidecar (default): independent identity and chat service. Explicit legacy is read-only compatibility.
BUBU_AUTH_MODE=sidecar
# Fixed WeChat profiles: development (default) or experience. Do not override BUBU_API_ORIGIN.
BUBU_API_PROFILE=development
# H5 local development only; browser requests stay same-origin and use the fixed local proxy.
BUBU_DEV_PROXY=http://127.0.0.1:3320

# Explicitly set the version authorized for this miniapp AppID. Blank keeps keyboard available.
BUBU_WECHAT_SI_VERSION=
