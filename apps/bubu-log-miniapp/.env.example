# legacy (default): existing NextAuth service; sidecar: independent identity service.
BUBU_AUTH_MODE=legacy
# WeChat build only. Public service address; never put AppSecret/passwords/CMS secrets here.
BUBU_API_ORIGIN=https://your-existing-diary.example
# H5 local development only; browser requests stay same-origin.
BUBU_DEV_PROXY=http://127.0.0.1:3000
