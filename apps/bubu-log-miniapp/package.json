{
  "name": "@cfp/bubu-log-miniapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm build:weapp && pnpm build:h5",
    "build:weapp": "node scripts/build-weapp.mjs development",
    "build:weapp:development": "node scripts/build-weapp.mjs development",
    "build:weapp:experience": "node scripts/build-weapp.mjs experience",
    "build:h5": "taro build --type h5",
    "dev:weapp": "node scripts/build-weapp.mjs development --watch",
    "dev:h5": "taro build --type h5 --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:environment && vitest run",
    "test:coverage": "pnpm test:environment && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chat-live": "playwright test --config playwright.chat-live.config.ts",
    "test:wxss": "node scripts/check-wxss.mjs development",
    "test:wxss:experience": "node scripts/check-wxss.mjs experience",
    "upload:experience": "node scripts/upload-experience.mjs",
    "test:environment": "node --test scripts/environment.test.mjs"
  },
  "dependencies": {
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "dayjs": "^1.11.13",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@cfp/eslint-config": "workspace:*",
    "@cfp/typescript-config": "workspace:*",
    "@playwright/test": "^1.57.0",
    "@tarojs/cli": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@types/node": "^20.19.30",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-test-renderer": "18.0.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.2",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vitest": "^1.6.1"
  }
}
