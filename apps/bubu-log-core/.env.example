# This service binds loopback only and must never be proxied by nginx.
BUBU_CORE_DATABASE_URL=
BUBU_CORE_PAYLOAD_SECRET=
BUBU_CORE_SERVICE_TOKEN=
BUBU_CORE_CMS_EMAIL=
AUTH_SECRET=
AUTH_URL=http://localhost:3321
# Enable only after snapshot verification and fencing ALL old writers.
BUBU_CORE_WRITES_ENABLED=false

# Explicit deprecated BabyProfile ID -> Baby ID mapping; never infer by nickname.
BUBU_CORE_LEGACY_PROFILE_OWNERS={}

# Exact, verified third-party OAuth avatar origins; owned/unknown media blocks account erasure.
BUBU_CORE_EXTERNAL_AVATAR_ORIGINS=
