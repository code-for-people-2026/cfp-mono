# Private absolute path outside the checkout; directory 700, file 600.
# Docker Compose >= 2.30, env_file format raw: write unquoted literal values.
# Fill on the server after rotating the runtime password; never paste secrets in chat.
# URL-encode credentials in the URL; do not reuse the migrator account.
KITH_INN_DATABASE_URL=
KITH_INN_WECHAT_APP_ID=
KITH_INN_WECHAT_APP_SECRET=
KITH_INN_WECHAT_OWNER_OPEN_ID=
# Exact socket peer address observed through Nginx; no CIDR/wildcards.
# Leave empty until verified; forwarded client headers are ignored by default.
KITH_INN_TRUSTED_PROXY_IP=
